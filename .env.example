# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
PINECONE_API_KEY=pcsk_...
TAVILY_API_KEY=tvly-...

# Provider: ollama (local, free) or openai
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Models (Ollama names; for OpenAI use gpt-4o / gpt-4o-mini / text-embedding-3-small + EMBEDDING_DIM=1536)
LLM_MODEL=qwen2.5:7b
GRADER_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Pinecone serverless index
PINECONE_INDEX=incident-kb-768
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Self-RAG limits
RETRIEVAL_K=4
RELEVANCE_MIN_DOCS=1
MAX_REWRITES=2
MAX_GENERATIONS=3
WEB_RESULTS=3

# Storage (SQLite files live in a Docker volume)
CHECKPOINT_DB=data/sqlite/checkpoints.db
APP_DB=data/sqlite/app.db

MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
