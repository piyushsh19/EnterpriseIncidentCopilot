# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
PINECONE_API_KEY=pcsk_...
TAVILY_API_KEY=tvly-...

# Models
LLM_MODEL=gpt-4o
GRADER_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Pinecone serverless index
PINECONE_INDEX=incident-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Self-RAG limits
RETRIEVAL_K=4
RELEVANCE_MIN_DOCS=1
MAX_REWRITES=2
MAX_GENERATIONS=3
WEB_RESULTS=3

# Storage (SQLite files live in a Docker volume)
CHECKPOINT_DB=data/sqlite/checkpoints.db
APP_DB=data/sqlite/app.db

MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
